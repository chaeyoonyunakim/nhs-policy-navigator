MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
GOOGLE_API_KEY=AIza...
DB_NAME=agentic-evolution-hackathon

# --- LLM generation provider ---
# Backend for answer generation, classification, re-ranking, and self-evaluation.
#   ollama (default) -- a local model; nothing leaves the machine, safe for
#                       confidential / non-public material.
#   gemini           -- the hosted Google Gemini API.
LLM_PROVIDER=ollama
# Local model served by Ollama. Run `ollama list` to see what you have pulled,
# then set this to match (e.g. qwen2.5, qwen3, llama3.1, mistral).
OLLAMA_MODEL=qwen2.5
OLLAMA_HOST=http://localhost:11434
# NOTE: GOOGLE_API_KEY is still required — embeddings use Gemini so the existing
# 768-dim Atlas vector index stays valid. Only generation runs locally.
